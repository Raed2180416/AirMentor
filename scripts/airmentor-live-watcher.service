[Unit]
Description=AirMentor Live Repo Watcher
After=network.target

[Service]
Type=simple
ExecStart=%h/Projects/air-mentor-ui/scripts/live-repo-watcher.sh
Restart=always
RestartSec=10
StandardOutput=append:%h/Projects/air-mentor-ui/.audit/live-watcher.log
StandardError=append:%h/Projects/air-mentor-ui/.audit/live-watcher.log

[Install]
WantedBy=default.target
