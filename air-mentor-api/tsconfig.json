{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": "..",
    "paths": {
      "@kernel/*": ["./kernel/*"],
      "@adapters/*": ["./adapters/*"],
      "@http/*": ["./adapters/http/*"],
      "@persistence/*": ["./adapters/persistence/*"],
      "@simulation/*": ["./adapters/simulation/*"],
      "@universities/*": ["./universities/*"]
    },
    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../kernel/**/*.ts", "../adapters/**/*.ts", "../universities/**/*.ts"]
}
